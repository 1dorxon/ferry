{
  "manifest_version": 3,
  "name": "Ferry: Send Files Nearby",
  "short_name": "Ferry",
  "version": "1.2.1",
  "description": "Send files and text between this computer and your phones on the same Wi-Fi. Straight from device to device: nothing is uploaded.",
  "homepage_url": "https://ferry.luitlabs.in/",
  "minimum_chrome_version": "123",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ferry",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "sidePanel",
    "notifications",
    "downloads",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://ferry.luitlabs.in/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://ferry.luitlabs.in wss://ferry.luitlabs.in"
  }
}
